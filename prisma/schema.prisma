generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TAMU
  RESEPSIONIS
  HOUSEKEEPING
  ADMIN
}

enum RoomStatus {
  TERSEDIA
  TERISI
  DIBERSIHKAN
  PERBAIKAN
}

enum ReservationStatus {
  MENUNGGU
  DIKONFIRMASI
  CHECK_IN
  CHECK_OUT
  DIBATALKAN
  DITOLAK
}

enum PaymentStatus {
  BELUM_DIBAYAR
  MENUNGGU_KONFIRMASI
  LUNAS
  DITOLAK
}

enum PaymentMethod {
  TRANSFER_BANK
  TUNAI
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         UserRole @default(TAMU)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reservations      Reservation[]
  pushSubscriptions PushSubscription[]
}

model RoomType {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  capacity    Int
  price       Decimal  @db.Decimal(12, 2)
  facilities  String[] @default([])
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms Room[]
}

model Room {
  id         Int        @id @default(autoincrement())
  roomNumber String     @unique
  floor      Int
  status     RoomStatus @default(TERSEDIA)
  roomTypeId Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  roomType          RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reservations      Reservation[]
  pushSubscriptions PushSubscription[]

  @@index([roomTypeId])
}

model Reservation {
  id          Int      @id @default(autoincrement())
  bookingCode String   @unique
  userId      Int
  roomId      Int
  checkIn     DateTime
  checkOut    DateTime
  guests      Int
  totalPrice  Decimal  @db.Decimal(12, 2)

  paymentStatus PaymentStatus  @default(BELUM_DIBAYAR)
  paymentMethod PaymentMethod?
  paymentProof  String?
  paidAt        DateTime?

  status    ReservationStatus @default(MENUNGGU)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([roomId, checkIn, checkOut])
  @@index([userId, createdAt])
  @@index([paymentStatus])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  room   Room? @relation(fields: [roomId], references: [id])
  roomId Int?

  @@index([userId])
}
